# Hourly, a few minutes past, so it does not meet the nightly jobs in the
# database (06_jobs: 03:17 and 03:47) on the hour. Persistent: an hour the
# machine was off is made up for when it comes back.
[Unit]
Description=Back up Rift central every hour

[Timer]
OnCalendar=*-*-* *:07:00
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
